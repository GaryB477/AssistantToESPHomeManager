    private static string CountdownTo(TimeOnly target)
    {
        var diff = target - TimeOnly.FromDateTime(DateTime.Now);
        return diff.TotalHours >= 1
            ? $"{(int)diff.TotalHours}h {diff.Minutes:D2}m"
            : $"{diff.Minutes}m";
    }

    private void ShowAction(string message)
    {
        _lastAction = message;
        _lastActionTime = DateTime.Now;
    }

    private async Task ToggleLight(EspBase device, LightEntity light)
    {
        var connection = device.Connection;
        if (connection == null) return;

        try
        {
            var newState = !light.GetValue();
            // Manual interaction: suspend the cycle so the scheduler doesn't revert it
            CycleService.ActivateOverride();
            await light.SetStateAsync(connection, newState);
            ShowAction($"Toggled {light.Name} to {(newState ? "ON" : "OFF")}");
        }
        catch (Exception ex)
        {
            ShowAction($"ERROR: {ex.Message}");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SetBrightness(EspBase device, LightEntity light, int percent)
    {
        var connection = device.Connection;
        if (connection == null) return;

        try
        {
            CycleService.ActivateOverride();
            await light.SetStateAsync(connection, true, percent / 100f);
            ShowAction($"Set {light.Name} to {percent}%");
        }
        catch (Exception ex)
        {
            ShowAction($"ERROR: {ex.Message}");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSwitch(EspBase device, SwitchEntity switchEntity)
    {
        var connection = device.Connection;
        if (connection == null) return;

        try
        {
            var newState = !switchEntity.GetValue();
            CycleService.ActivateOverride();
            await switchEntity.SetStateAsync(connection, newState);
            ShowAction($"Toggled {switchEntity.Name} to {(newState ? "ON" : "OFF")}");
        }
        catch (Exception ex)
        {
            ShowAction($"ERROR: {ex.Message}");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleOverride()
    {
        if (CycleService.OverrideActive)
        {
            await CycleService.DeactivateOverride();
            ShowAction("Override deactivated - cycle resumed");
        }
        else
        {
            CycleService.ActivateOverride();
            ShowAction("Override activated until next phase change");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveCycles()
    {
        if (CycleService.CycleConfig == null) return;

        try
        {
            await CycleService.UpdateConfig(CycleService.CycleConfig);
            ShowAction("Cycle configuration saved");
        }
        catch (Exception ex)
        {
            ShowAction($"ERROR saving cycles: {ex.Message}");
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        EspService.OnDevicesUpdated -= OnUpdated;
        CycleService.OnCycleChanged -= OnUpdated;
        AcService.OnControllersUpdated -= OnUpdated;
        _clock?.Dispose();
    }
