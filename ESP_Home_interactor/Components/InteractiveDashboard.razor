@namespace ESP_Home_Interactor.Components
@using ESP_Home_Interactor.AcInfinity
@using ESP_Home_Interactor.Config
@using ESP_Home_Interactor.Services
@using ESP_Home_Interactor.Entities
@using System.Globalization
@inject EspDeviceService EspService
@inject CycleSchedulerService CycleService
@inject AcInfinityService AcService
@inject SensorHistoryService HistoryService
@implements IDisposable

<div class="dashboard">
    <header class="app-header">
        <div class="app-title">
            <h1><span class="app-logo">@IconLeaf</span> HomePeter</h1>
            <p class="app-subtitle">Homegrow Dashboard</p>
        </div>
        <div class="header-right">
            <button class="icon-button @(_showSettings ? "active" : "")" type="button" title="Settings"
                    @onclick="() => _showSettings = !_showSettings">@IconGear</button>
            <div class="app-clock">@DateTime.Now.ToString("HH:mm")</div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_lastAction) && (DateTime.Now - _lastActionTime).TotalSeconds < 6)
    {
        <div class="toast @(_lastAction.StartsWith("ERROR") ? "error" : "")">@_lastAction</div>
    }

    @if (_showSettings)
    {
        <ConfigEditor/>
    }

    <section class="cycle-card">
        <div class="cycle-head">
            <h2>Light Cycle</h2>
            @if (CycleService.CurrentPhase != null)
            {
                <div class="cycle-status">
                    <span class="phase-badge @PhaseClass(CycleService.CurrentPhase.Name)">
                        @PhaseIcon(CycleService.CurrentPhase.Name) @CycleService.CurrentPhase.Name
                    </span>
                    @if (CycleService.NextPhase is { } next)
                    {
                        <span class="cycle-next">
                            @PhaseIcon(next.Name) @next.Name in <strong>@CountdownTo(next.Start)</strong> (@next.Start.ToString("HH:mm"))
                        </span>
                    }
                    <button class="override-pill @(CycleService.OverrideActive ? "active" : "")"
                            type="button"
                            @onclick="ToggleOverride">
                        <span class="pill-dot"></span>
                        @(CycleService.OverrideActive ? "Override active" : "Auto")
                    </button>
                </div>
            }
            else
            {
                <p class="muted">No active cycle</p>
            }
        </div>

        @if (CycleService.CycleConfig is { } stageConfig)
        {
            <div class="stage-bar">
                <div class="stage-buttons">
                    @foreach (var stage in LightCycleConfig.Stages)
                    {
                        var currentStage = stage;
                        <button class="stage-button @(stageConfig.ActiveStage == stage ? "active" : "")"
                                type="button"
                                @onclick="() => SelectStage(currentStage)">
                            @StageIcon(stage) @stage
                        </button>
                    }
                </div>
                @if (stageConfig is { ActiveStage: not null, ActiveSince: not null })
                {
                    <span class="stage-since">
                        since @stageConfig.ActiveSince.Value.ToString("d.M.yyyy HH:mm")
                        · <strong>@FormatDuration(DateTime.Now - stageConfig.ActiveSince.Value)</strong>
                    </span>
                    <button class="stage-reset" type="button" title="Reset stage selection"
                            @onclick="ResetStage">Reset</button>
                }
            </div>
        }

        @foreach (var warning in GetCycleWarnings())
        {
            <div class="cycle-warning">@IconAlert @warning</div>
        }

        @if (CycleService.CycleConfig != null && CycleService.CycleConfig.ActivePhases.Count > 0)
        {
            <div class="timeline">
                <div class="timeline-track">
                    @foreach (var seg in GetTimelineSegments())
                    {
                        <div class="timeline-seg @seg.Cls"
                             style="left:@(Pct(seg.LeftPct));width:@(Pct(seg.WidthPct))"
                             title="@seg.Label"></div>
                    }
                    <div class="timeline-now" style="left:@(Pct(NowPct()))"></div>
                </div>
                <div class="timeline-labels">
                    <span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00</span>
                </div>
            </div>
        }

        @if (CycleService.CycleConfig is { } cycleConfig)
        {
            <button class="editor-toggle" type="button" @onclick="() => _showEditor = !_showEditor">
                @(_showEditor ? "▴ Hide cycle editor" : "▾ Edit cycles")
            </button>

            @if (_showEditor)
            {
                <div class="cycle-editor">
                    <div class="stage-tabs">
                        @foreach (var stage in LightCycleConfig.Stages)
                        {
                            var currentStage = stage;
                            <button class="stage-tab @(EditorStage == stage ? "active" : "")" type="button"
                                    @onclick="() => _editorStage = currentStage">
                                @stage
                                @if (cycleConfig.ActiveStage == stage)
                                {
                                    <span class="stage-tab-dot"></span>
                                }
                            </button>
                        }
                    </div>
                    @foreach (var (phase, index) in EditorPhases.Select((p, i) => (p, i)))
                    {
                        var currentPhase = phase;
                        <div class="phase-editor @PhaseClass(phase.Name)">
                            <div class="phase-editor-head">
                                <h3>@PhaseIcon(phase.Name)</h3>
                                <input class="phase-name" type="text"
                                       value="@phase.Name"
                                       @onchange="@(e => currentPhase.Name = (string)e.Value!)" />
                                <button class="remove-button" type="button" title="Remove phase"
                                        @onclick="() => EditorPhases.Remove(currentPhase)">✕</button>
                            </div>
                            <label class="field">
                                <span>Start</span>
                                <input type="time"
                                       value="@phase.Start.ToString("HH:mm")"
                                       @onchange="@(e => currentPhase.Start = TimeOnly.Parse((string)e.Value!))" />
                            </label>
                            @foreach (var actor in phase.Actors)
                            {
                                var currentActor = actor;
                                var actorDevice = FindDevice(currentActor);
                                var entities = actorDevice != null ? DeviceEntities(actorDevice) : new List<(string ObjectId, string Label)>();
                                <div class="actor-editor">
                                    <div class="actor-ref">
                                        <select class="ref-select" value="@currentActor.Node"
                                                @onchange="@(e => OnActorNodeChanged(currentActor, (string)e.Value!))">
                                            @foreach (var device in EspService.Devices)
                                            {
                                                <option value="@device.Name" selected="@(device.Name == currentActor.Node)">@device.Name</option>
                                            }
                                            @if (ActorMissing(currentActor))
                                            {
                                                <option value="@currentActor.Node" selected>@currentActor.Node — not configured</option>
                                            }
                                        </select>
                                        <select class="ref-select" value="@currentActor.ObjectId"
                                                @onchange="@(e => OnActorEntityChanged(currentActor, (string)e.Value!))">
                                            @foreach (var entity in entities)
                                            {
                                                <option value="@entity.ObjectId" selected="@(entity.ObjectId == currentActor.ObjectId)">@entity.Label</option>
                                            }
                                            @if (entities.All(x => x.ObjectId != currentActor.ObjectId))
                                            {
                                                <option value="@currentActor.ObjectId" selected>@currentActor.ObjectId</option>
                                            }
                                        </select>
                                        <button class="remove-button" type="button" title="Remove actor"
                                                @onclick="() => currentPhase.Actors.Remove(currentActor)">✕</button>
                                    </div>
                                    <label class="field checkbox">
                                        <input type="checkbox"
                                               checked="@actor.On"
                                               @onchange="@(e => currentActor.On = (bool)e.Value!)" />
                                        <span>On</span>
                                    </label>
                                    @if (actor.Brightness.HasValue)
                                    {
                                        <label class="field slider">
                                            <span>Brightness <strong>@((int)(actor.Brightness.Value * 100))%</strong></span>
                                            <input type="range" min="1" max="100"
                                                   value="@((int)(actor.Brightness.Value * 100))"
                                                   @onchange="@(e => currentActor.Brightness = int.Parse((string)e.Value!) / 100f)" />
                                        </label>
                                    }
                                </div>
                            }
                            @foreach (var fan in phase.AcFans)
                            {
                                var currentFan = fan;
                                var fanController = AcService.Controllers.FirstOrDefault(c => c.Name == currentFan.Controller);
                                <div class="actor-editor">
                                    <div class="actor-ref">
                                        <select class="ref-select" value="@currentFan.Controller"
                                                @onchange="@(e => OnFanControllerChanged(currentFan, (string)e.Value!))">
                                            @foreach (var controller in AcService.Controllers)
                                            {
                                                <option value="@controller.Name" selected="@(controller.Name == currentFan.Controller)">@controller.Name</option>
                                            }
                                            @if (FanMissing(currentFan))
                                            {
                                                <option value="@currentFan.Controller" selected>@currentFan.Controller — not configured</option>
                                            }
                                        </select>
                                        <select class="ref-select" value="@currentFan.Port"
                                                @onchange="@(e => currentFan.Port = int.Parse((string)e.Value!))">
                                            @if (fanController != null)
                                            {
                                                @foreach (var port in fanController.Ports)
                                                {
                                                    <option value="@port.Port" selected="@(port.Port == currentFan.Port)">@port.Name (port @port.Port)</option>
                                                }
                                            }
                                            else
                                            {
                                                <option value="@currentFan.Port" selected>port @currentFan.Port</option>
                                            }
                                        </select>
                                        <button class="remove-button" type="button" title="Remove fan"
                                                @onclick="() => currentPhase.AcFans.Remove(currentFan)">✕</button>
                                    </div>
                                    <label class="field slider">
                                        <span>Level <strong>@fan.Level/10</strong></span>
                                        <input type="range" min="0" max="10"
                                               value="@fan.Level"
                                               @onchange="@(e => currentFan.Level = int.Parse((string)e.Value!))" />
                                    </label>
                                </div>
                            }
                            <div class="editor-add-row">
                                <button class="add-button" type="button" @onclick="() => AddActor(currentPhase)">+ Actor</button>
                                <button class="add-button" type="button" @onclick="() => AddFan(currentPhase)">+ Fan</button>
                            </div>
                        </div>
                    }
                    <button class="add-button add-phase" type="button" @onclick="AddPhase">+ Add phase</button>
                    <button class="save-button" type="button" @onclick="SaveCycles">Save cycles</button>
                </div>
            }
        }
    </section>

    @foreach (var controller in AcService.Controllers)
    {
        var chart = BuildCombinedChart(controller);

        <section class="cycle-card">
            <div class="cycle-head">
                <h2>History · @controller.Name</h2>
            </div>
            @if (chart == null)
            {
                <p class="chart-empty">Collecting data — charts appear after a few minutes</p>
            }
            else
            {
                <div class="chart">
                    <div class="chart-head">
                        <span class="chart-legend">
                            <span class="legend-swatch temp"></span> Temperature
                            <span class="chart-minmax">min @Fmt(chart.TempMin) · max @Fmt(chart.TempMax) °C</span>
                        </span>
                        @if (chart.VpdPath != null)
                        {
                            <span class="chart-legend">
                                <span class="legend-swatch vpd"></span> VPD
                                <span class="chart-minmax">min @F2(chart.VpdMin) · max @F2(chart.VpdMax) kPa</span>
                            </span>
                        }
                    </div>
                    @* direction:rtl on the scroll container anchors the initial scroll
                       position at the right edge (= now) without any JS *@
                    <div class="chart-scroll">
                        <div class="chart-inner" style="width:@Pct(chart.WidthPct)">
                            <svg class="chart-plot" viewBox="0 0 @Fmt(chart.ViewWidth) 130">
                                @foreach (var band in chart.LightBands)
                                {
                                    <rect class="light-band" x="@Fmt(band.X)" y="8" width="@Fmt(band.Width)" height="78"
                                          style="fill-opacity:@band.Opacity.ToString("F2", CultureInfo.InvariantCulture)"/>
                                }
                                @for (var i = 1; i <= 3; i++)
                                {
                                    var gy = Fmt(8 + (86 - 8) * i / 4.0);
                                    <line class="grid" x1="6" x2="@Fmt(chart.ViewWidth - 6)" y1="@gy" y2="@gy"/>
                                }
                                <line class="grid" x1="6" x2="@Fmt(chart.ViewWidth - 6)" y1="86" y2="86"/>
                                @foreach (var label in chart.TimeLabels)
                                {
                                    @* The <g> wrapper keeps Razor from parsing <text> as its transition tag *@
                                    <g>
                                        <line class="grid" x1="@Fmt(label.X)" x2="@Fmt(label.X)" y1="8" y2="86"/>
                                        <text class="tlabel" x="@Fmt(label.X)" y="101" text-anchor="middle">@label.Label</text>
                                    </g>
                                }
                                <path class="series temp" d="@chart.TempPath"/>
                                @if (chart.VpdPath != null)
                                {
                                    <path class="series vpd" d="@chart.VpdPath"/>
                                }
                                @foreach (var dot in chart.Dots)
                                {
                                    <circle class="series-dot @dot.Cls" cx="@Fmt(dot.X)" cy="@Fmt(dot.Y)" r="2"/>
                                }
                                @foreach (var p in chart.Points)
                                {
                                    <g class="hpt">
                                        <rect x="@Fmt(p.X - chart.HoverWidth / 2)" y="0" width="@Fmt(chart.HoverWidth)" height="130" fill="transparent"/>
                                        <line x1="@Fmt(p.X)" x2="@Fmt(p.X)" y1="8" y2="86"/>
                                        @if (p.TempY is { } tempY)
                                        {
                                            <circle class="temp" cx="@Fmt(p.X)" cy="@Fmt(tempY)" r="3"/>
                                        }
                                        @if (p.VpdY is { } vpdY)
                                        {
                                            <circle class="vpd" cx="@Fmt(p.X)" cy="@Fmt(vpdY)" r="3"/>
                                        }
                                        <text x="@Fmt(Math.Clamp(p.X, 110, chart.ViewWidth - 110))" y="122" text-anchor="middle">@p.Tip</text>
                                    </g>
                                }
                            </svg>
                        </div>
                    </div>
                </div>
            }
        </section>
    }

    @if (!EspService.Devices.Any() && !AcService.Controllers.Any())
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Connecting to ESP devices...</p>
        </div>
    }
    else
    {
        <div class="device-grid">
            @foreach (var controller in AcService.Controllers)
            {
                var online = controller.LastSeen.HasValue &&
                             (DateTime.Now - controller.LastSeen.Value).TotalSeconds < 60;
                <section class="device-card @(online ? "" : "offline")">
                    <div class="device-head">
                        <span class="conn-dot @(online ? "online" : "")"></span>
                        <h2>@controller.Name</h2>
                        <span class="conn-label">@(online ? "advertising" : "not seen")</span>
                    </div>

                    <div class="entity-section">
                        <h3>Climate</h3>
                        <div class="sensor-grid">
                            <div class="sensor-tile">
                                <span class="sensor-value">@(controller.Temperature?.ToString("F1") ?? "–") °C</span>
                                <span class="sensor-name">Temperature</span>
                            </div>
                            <div class="sensor-tile">
                                <span class="sensor-value">@(controller.Humidity?.ToString("F1") ?? "–") %</span>
                                <span class="sensor-name">Humidity</span>
                            </div>
                            <div class="sensor-tile">
                                <span class="sensor-value">@(controller.Vpd?.ToString("F2") ?? "–") kPa</span>
                                <span class="sensor-name">VPD</span>
                            </div>
                        </div>
                    </div>

                    <div class="entity-section">
                        <h3>Fans</h3>
                        @foreach (var port in controller.Ports)
                        {
                            var currentController = controller;
                            var currentPort = port;
                            var level = controller.PortLevels.GetValueOrDefault(port.Port, 0);
                            <div class="entity-card fan @(level > 0 ? "on" : "")">
                                <div class="entity-head">
                                    <span class="entity-icon">@IconFan</span>
                                    <span class="entity-name">@port.Name</span>
                                    <button class="toggle-pill @(level > 0 ? "on" : "")"
                                            type="button"
                                            disabled="@_acCommandRunning"
                                            @onclick="@(async () => await SetFanLevel(currentController, currentPort.Port, level > 0 ? 0 : 10))">
                                        @(level > 0 ? $"LVL {level}" : "OFF")
                                    </button>
                                </div>
                                <div class="brightness-row">
                                    <span class="brightness-value">@level<small>/10</small></span>
                                    <input type="range" min="0" max="10"
                                           value="@level"
                                           disabled="@_acCommandRunning"
                                           @onchange="@(async e => await SetFanLevel(currentController, currentPort.Port, int.Parse((string)e.Value!)))" />
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
            @foreach (var device in EspService.Devices.Where(d => d.Host != AcService.ProxyHost))
            {
                <section class="device-card @(device.IsConnected ? "" : "offline")">
                    <div class="device-head">
                        <span class="conn-dot @(device.IsConnected ? "online" : "")"></span>
                        <h2>@device.Name @if (device.Name != device.Host)
                                         {
                                             <small>@device.Host</small>
                                         }</h2>
                        <span class="conn-label">@(device.IsConnected ? "connected" : "offline")</span>
                    </div>

                    @if (device.LightEntities.Any())
                    {
                        <div class="entity-section">
                            <h3>Lights</h3>
                            @foreach (var light in device.LightEntities)
                            {
                                var currentDevice = device;
                                var currentLight = light;
                                <div class="entity-card light @(light.GetValue() ? "on" : "")">
                                    <div class="entity-head">
                                        <span class="entity-icon">@IconBulb</span>
                                        <span class="entity-name">@light.Name</span>
                                        <button class="toggle-pill @(light.GetValue() ? "on" : "")"
                                                type="button"
                                                disabled="@(!device.IsConnected)"
                                                @onclick="@(async () => await ToggleLight(currentDevice, currentLight))">
                                            @(light.GetValue() ? "ON" : "OFF")
                                        </button>
                                    </div>
                                    @if (light.SupportsBrightness)
                                    {
                                        <div class="brightness-row">
                                            <span class="brightness-value">@((int)(light.Brightness * 100))<small>%</small></span>
                                            <input type="range" min="1" max="100"
                                                   value="@((int)(light.Brightness * 100))"
                                                   disabled="@(!device.IsConnected)"
                                                   @onchange="@(async e => await SetBrightness(currentDevice, currentLight, int.Parse((string)e.Value!)))" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (device.SwitchEntities.Any())
                    {
                        <div class="entity-section">
                            <h3>Switches</h3>
                            @foreach (var switchEntity in device.SwitchEntities)
                            {
                                var currentDevice = device;
                                var currentSwitch = switchEntity;
                                <div class="entity-card @(switchEntity.GetValue() ? "on" : "")">
                                    <div class="entity-head">
                                        <span class="entity-icon">@IconPlug</span>
                                        <span class="entity-name">@switchEntity.Name</span>
                                        <button class="toggle-pill @(switchEntity.GetValue() ? "on" : "")"
                                                type="button"
                                                disabled="@(!device.IsConnected)"
                                                @onclick="@(async () => await ToggleSwitch(currentDevice, currentSwitch))">
                                            @(switchEntity.GetValue() ? "ON" : "OFF")
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (device.SensorEntities.Any() || device.BinarySensorEntities.Any())
                    {
                        <div class="entity-section">
                            <h3>Sensors</h3>
                            <div class="sensor-grid">
                                @foreach (var sensor in device.SensorEntities)
                                {
                                    <div class="sensor-tile">
                                        <span class="sensor-value">@sensor.GetDisplayValue()</span>
                                        <span class="sensor-name">@sensor.Name</span>
                                    </div>
                                }
                                @foreach (var binarySensor in device.BinarySensorEntities)
                                {
                                    <div class="sensor-tile">
                                        <span class="sensor-value">@binarySensor.GetDisplayValue()</span>
                                        <span class="sensor-name">@binarySensor.Name</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>
            }
            @if (CycleService.CycleConfig is { } growthConfig)
            {
                <section class="device-card">
                    <div class="device-head">
                        <h2>Growth Stages</h2>
                    </div>
                    <div class="stage-summary">
                        @foreach (var stage in LightCycleConfig.Stages)
                        {
                            var total = StageTotal(growthConfig, stage);
                            var ongoing = growthConfig.ActiveStage == stage;
                            <div class="stage-summary-row @(ongoing ? "ongoing" : "")">
                                <span class="stage-summary-name">@StageIcon(stage) @stage</span>
                                <span class="stage-summary-duration">@(total is { } t ? FormatDuration(t) : "–")</span>
                                @if (ongoing)
                                {
                                    <span class="stage-summary-status ongoing">ongoing</span>
                                }
                                else if (total != null)
                                {
                                    <span class="stage-summary-status">finished</span>
                                }
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@code {
    private string _lastAction = "";
    private DateTime _lastActionTime;
    private bool _showEditor;
    private bool _showSettings;
    private bool _acCommandRunning;
    private System.Threading.Timer? _clock;
    private string? _editorStage;

    /// <summary>Stage whose preset the editor shows; defaults to the active stage</summary>
    private string EditorStage => _editorStage ?? CycleService.CycleConfig?.ActiveStage ?? LightCycleConfig.Stages[0];

    private List<CyclePhase> EditorPhases =>
        CycleService.CycleConfig?.Presets.GetValueOrDefault(EditorStage) ?? new List<CyclePhase>();

    private async Task SelectStage(string stage)
    {
        if (CycleService.CycleConfig?.ActiveStage == stage) return;

        try
        {
            await CycleService.SelectStage(stage);
            ShowAction($"Growth stage set to {stage}");
        }
        catch (Exception ex)
        {
            ShowAction($"ERROR: {ex.Message}");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetStage()
    {
        try
        {
            await CycleService.SelectStage(null);
            ShowAction("Growth stages reset - history cleared, cycle enforcement paused");
        }
        catch (Exception ex)
        {
            ShowAction($"ERROR: {ex.Message}");
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Total time spent in a stage (all history entries plus the running
    /// selection); null when the stage was never selected</summary>
    private static TimeSpan? StageTotal(LightCycleConfig config, string stage)
    {
        var entries = config.StageHistory.Where(e => e.Stage == stage).ToList();
        var total = entries.Aggregate(TimeSpan.Zero, (sum, e) => sum + (e.To - e.From));

        if (config.ActiveStage == stage && config.ActiveSince != null)
            return total + (DateTime.Now - config.ActiveSince.Value);

        return entries.Count > 0 ? total : null;
    }

    private static string FormatDuration(TimeSpan duration) =>
        duration.TotalDays >= 1 ? $"{(int)duration.TotalDays}d {duration.Hours}h"
        : duration.TotalHours >= 1 ? $"{(int)duration.TotalHours}h {duration.Minutes}m"
        : $"{Math.Max((int)duration.TotalMinutes, 0)}m";

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            EspService.OnDevicesUpdated += OnUpdated;
            CycleService.OnCycleChanged += OnUpdated;
            AcService.OnControllersUpdated += OnUpdated;
            _clock = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
        }
    }

    private async Task SetFanLevel(AcInfinityController controller, int port, int level)
    {
        _acCommandRunning = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Manual interaction: suspend the cycle so the scheduler doesn't revert it
            CycleService.ActivateOverride();
            await controller.SetLevelAsync(port, level);
            ShowAction($"{controller.Name}: port {port} set to level {level}");
        }
        catch (Exception ex)
        {
            ShowAction($"ERROR: {ex.Message}");
        }
        finally
        {
            _acCommandRunning = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void OnUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    private record TimelineSegment(double LeftPct, double WidthPct, string Cls, string Label);

    private IEnumerable<TimelineSegment> GetTimelineSegments()
    {
        var config = CycleService.CycleConfig;
        if (config == null || config.ActivePhases.Count == 0) yield break;

        var sorted = config.ActivePhases.OrderBy(p => p.Start).ToList();
        for (var i = 0; i < sorted.Count; i++)
        {
            var startMin = sorted[i].Start.Hour * 60 + sorted[i].Start.Minute;
            var nextStart = sorted[(i + 1) % sorted.Count].Start;
            var endMin = nextStart.Hour * 60 + nextStart.Minute;
            if (endMin <= startMin) endMin += 1440;

            var cls = PhaseClass(sorted[i].Name);
            var label = $"{sorted[i].Name}: {sorted[i].Start:HH\\:mm} - {nextStart:HH\\:mm}";

            if (endMin <= 1440)
            {
                yield return new TimelineSegment(startMin / 14.4, (endMin - startMin) / 14.4, cls, label);
            }
            else
            {
                // Segment wraps past midnight: split in two
                yield return new TimelineSegment(startMin / 14.4, (1440 - startMin) / 14.4, cls, label);
                yield return new TimelineSegment(0, (endMin - 1440) / 14.4, cls, label);
            }
        }
    }

    private double NowPct()
    {
        var now = DateTime.Now;
        return (now.Hour * 60 + now.Minute) / 14.4;
    }

    private static string Pct(double value) => $"{value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%";

    private string PhaseClass(string phaseName)
    {
        var config = CycleService.CycleConfig;
        var index = config?.ActivePhases.OrderBy(p => p.Start).ToList().FindIndex(p => p.Name == phaseName) ?? 0;
        return $"phase-{Math.Max(index, 0) % 4}";
    }

    // Chart geometry: plot area inside a "600-per-screen" viewBox; the viewBox
    // grows past 600 when the history spans more than one 48h screen
    private const double ChartLeft = 6, ChartTop = 8, ChartBottom = 86;
    private static readonly TimeSpan BucketSize = TimeSpan.FromMinutes(6);
    private static readonly TimeSpan MaxWindow = TimeSpan.FromHours(48);

    private record HoverPoint(double X, double? TempY, double? VpdY, string Tip);

    private record CombinedChart(
        double ViewWidth, double WidthPct, double HoverWidth,
        string TempPath, double TempMin, double TempMax,
        string? VpdPath, double VpdMin, double VpdMax,
        List<HoverPoint> Points,
        List<(double X, double Y, string Cls)> Dots,
        List<(double X, double Width, double Opacity)> LightBands,
        List<(double X, string Label)> TimeLabels);

    private record SeriesData(string Path, double Min, double Max,
        Dictionary<int, (double X, double Y, double Value)> ByIndex, List<(double X, double Y)> IsolatedDots);

    /// <summary>
    /// One chart holding both series. The x axis spans from the first sample
    /// to now: up to 48h it fills the card, beyond that the chart gets
    /// proportionally wider and scrolls horizontally (one screen = 48h).
    /// Both series are normalized to their own min/max.
    /// </summary>
    private CombinedChart? BuildCombinedChart(AcInfinityController controller)
    {
        var samples = HistoryService.GetHistory(controller.Name);
        if (samples.Count < 2) return null;

        var now = DateTime.Now;
        var start = samples[0].Time;
        var span = now - start;
        // A minutes-old history stretched across the full width looks broken - keep an hour floor
        if (span < TimeSpan.FromHours(1)) span = TimeSpan.FromHours(1);
        var visible = span > MaxWindow ? MaxWindow : span;
        var stretch = span / visible;
        var viewW = 600.0 * stretch;
        var plotW = viewW - 2 * ChartLeft;

        var temp = BuildSeries(samples, start, span, plotW, s => s.Temperature, 0.5);
        if (temp == null) return null;
        var vpd = BuildSeries(samples, start, span, plotW, s => s.Vpd, 0.05);

        // Effective light level per bucket (actual lamp state, not the cycle target)
        var lightByIndex = samples
            .Where(s => s.Light != null)
            .GroupBy(s => (int)((s.Time - start) / BucketSize))
            .ToDictionary(g => g.Key, g => g.Average(s => s.Light!.Value));

        var bandWidth = plotW / (span / BucketSize);
        var lightBands = lightByIndex
            .Where(kv => kv.Value > 0)
            .OrderBy(kv => kv.Key)
            .Select(kv => (X: ChartLeft + bandWidth * kv.Key, Width: bandWidth,
                Opacity: 0.06 + 0.16 * kv.Value))
            .ToList();

        // Merged hover points: one tooltip per bucket covering both series
        var showDate = span > TimeSpan.FromHours(24);
        var indices = temp.ByIndex.Keys
            .Union(vpd?.ByIndex.Keys ?? Enumerable.Empty<int>())
            .OrderBy(i => i);
        var points = new List<HoverPoint>();
        foreach (var index in indices)
        {
            var time = start + BucketSize * (index + 0.5);
            var x = ChartLeft + plotW * ((time - start) / span);
            var parts = new List<string>();
            double? tempY = null, vpdY = null;
            if (temp.ByIndex.TryGetValue(index, out var tp))
            {
                tempY = tp.Y;
                parts.Add($"{Fmt(tp.Value)} °C");
            }
            if (vpd != null && vpd.ByIndex.TryGetValue(index, out var vp))
            {
                vpdY = vp.Y;
                parts.Add($"{F2(vp.Value)} kPa");
            }
            if (lightByIndex.TryGetValue(index, out var light))
                parts.Add($"light {(int)Math.Round(light * 100)}%");
            parts.Add(time.ToString(showDate ? "d.M. HH:mm" : "HH:mm"));
            points.Add(new HoverPoint(x, tempY, vpdY, string.Join(" · ", parts)));
        }

        // Wall-clock aligned axis labels, at most ~8 per 48h screen
        var stepHours = new[] { 1, 2, 3, 6, 12, 24 }.First(h => visible.TotalHours / h <= 8);
        var labels = new List<(double X, string Label)>();
        var tick = start.Date;
        while (tick < start) tick = tick.AddHours(stepHours);
        for (; tick <= now; tick = tick.AddHours(stepHours))
        {
            var x = ChartLeft + plotW * ((tick - start) / span);
            labels.Add((x, tick.Hour == 0 ? tick.ToString("d.M.") : tick.ToString("HH:mm")));
        }

        var dots = new List<(double X, double Y, string Cls)>();
        dots.AddRange(temp.IsolatedDots.Select(d => (d.X, d.Y, Cls: "temp")));
        if (vpd != null)
            dots.AddRange(vpd.IsolatedDots.Select(d => (d.X, d.Y, Cls: "vpd")));

        return new CombinedChart(viewW, stretch * 100, bandWidth,
            temp.Path, temp.Min, temp.Max,
            vpd?.Path, vpd?.Min ?? 0, vpd?.Max ?? 0,
            points, dots, lightBands, labels);
    }

    private static SeriesData? BuildSeries(IReadOnlyList<HistorySample> samples, DateTime start, TimeSpan span,
        double plotW, Func<HistorySample, double?> select, double minPad)
    {
        // Average into 6-minute buckets; missing buckets become gaps in the line
        var buckets = samples
            .Where(s => select(s) != null)
            .GroupBy(s => (int)((s.Time - start) / BucketSize))
            .OrderBy(g => g.Key)
            .Select(g => (Index: g.Key, Value: g.Average(s => select(s)!.Value)))
            .ToList();
        if (buckets.Count == 0) return null;

        var min = buckets.Min(b => b.Value);
        var max = buckets.Max(b => b.Value);
        var pad = Math.Max((max - min) * 0.1, minPad);
        var lo = min - pad;
        var hi = max + pad;

        var path = new System.Text.StringBuilder();
        var byIndex = new Dictionary<int, (double X, double Y, double Value)>();
        var isolatedDots = new List<(double X, double Y)>();
        var indices = buckets.Select(b => b.Index).ToHashSet();
        var prevIndex = int.MinValue;

        foreach (var b in buckets)
        {
            var time = start + BucketSize * (b.Index + 0.5);
            var x = ChartLeft + plotW * ((time - start) / span);
            var y = ChartBottom - (ChartBottom - ChartTop) * (b.Value - lo) / (hi - lo);
            path.Append(b.Index == prevIndex + 1 ? 'L' : 'M').Append(Fmt(x)).Append(' ').Append(Fmt(y));
            // A bucket with no neighbours draws no line segment - it needs a dot
            if (!indices.Contains(b.Index - 1) && !indices.Contains(b.Index + 1))
                isolatedDots.Add((x, y));
            byIndex[b.Index] = (x, y, b.Value);
            prevIndex = b.Index;
        }

        return new SeriesData(path.ToString(), min, max, byIndex, isolatedDots);
    }

    private static string Fmt(double value) => value.ToString("F1", CultureInfo.InvariantCulture);

    private static string F2(double value) => value.ToString("F2", CultureInfo.InvariantCulture);

    /// <summary>
    /// Cycle entries pointing at hosts/controllers that are not in the config
    /// can never be enforced - surface that in the UI instead of only logging.
    /// </summary>
    private List<string> GetCycleWarnings()
    {
        var warnings = new List<string>();
        var config = CycleService.CycleConfig;
        if (config == null) return warnings;

        // During startup nothing is loaded yet - suppress the false alarm
        if (!EspService.Devices.Any() && !AcService.Controllers.Any()) return warnings;

        if (config.ActiveStage == null)
            warnings.Add("No growth stage selected — lights and fans are not being controlled");
        else if (config.ActivePhases.Count == 0)
            warnings.Add($"The {config.ActiveStage} preset has no phases — lights and fans are not being controlled");

        // Only the active preset is enforced - broken references elsewhere show in the editor
        foreach (var phase in config.ActivePhases)
        {
            foreach (var actor in phase.Actors.Where(ActorMissing))
                warnings.Add($"{actor.ObjectId} → {actor.Node}: node not configured — the cycle cannot control this actor");
            foreach (var fan in phase.AcFans.Where(FanMissing))
                warnings.Add($"{fan.Controller} · port {fan.Port}: controller not configured — the cycle cannot control this fan");
        }

        return warnings.Distinct().ToList();
    }

    private bool ActorMissing(ActorState actor) =>
        EspService.Devices.All(d => d.Name != actor.Node && d.Host != actor.Node);

    private bool FanMissing(AcFanState fan) =>
        AcService.Controllers.All(c => c.Name != fan.Controller);

    private EspBase? FindDevice(ActorState actor) =>
        EspService.Devices.FirstOrDefault(d => d.Name == actor.Node || d.Host == actor.Node);

    private static List<(string ObjectId, string Label)> DeviceEntities(EspBase device) =>
        device.LightEntities.Select(l => (l.ObjectId, $"{l.Name} · light"))
            .Concat(device.SwitchEntities.Select(s => (s.ObjectId, $"{s.Name} · switch")))
            .ToList();

    private void OnActorNodeChanged(ActorState actor, string nodeName)
    {
        actor.Node = nodeName;
        var device = FindDevice(actor);
        var entities = device != null ? DeviceEntities(device) : new List<(string ObjectId, string Label)>();
        if (entities.Count > 0 && entities.All(e => e.ObjectId != actor.ObjectId))
            actor.ObjectId = entities[0].ObjectId;
        SyncBrightness(actor);
    }

    private void OnActorEntityChanged(ActorState actor, string objectId)
    {
        actor.ObjectId = objectId;
        SyncBrightness(actor);
    }

    /// <summary>Brightness only makes sense on dimmable lights - add/remove it with the entity type</summary>
    private void SyncBrightness(ActorState actor)
    {
        var light = FindDevice(actor)?.LightEntities.FirstOrDefault(l => l.ObjectId == actor.ObjectId);
        actor.Brightness = light is { SupportsBrightness: true } ? actor.Brightness ?? 1f : null;
    }

    private void OnFanControllerChanged(AcFanState fan, string controllerName)
    {
        fan.Controller = controllerName;
        var controller = AcService.Controllers.FirstOrDefault(c => c.Name == controllerName);
        if (controller != null && controller.Ports.All(p => p.Port != fan.Port) && controller.Ports.Count > 0)
            fan.Port = controller.Ports[0].Port;
    }

    private void AddActor(CyclePhase phase)
    {
        var device = EspService.Devices.FirstOrDefault(d => d.LightEntities.Any() || d.SwitchEntities.Any());
        if (device == null)
        {
            ShowAction("ERROR: no device with controllable entities found");
            return;
        }

        var actor = new ActorState { Node = device.Name, ObjectId = DeviceEntities(device)[0].ObjectId, On = false };
        SyncBrightness(actor);
        phase.Actors.Add(actor);
    }

    private void AddFan(CyclePhase phase)
    {
        var controller = AcService.Controllers.FirstOrDefault(c => c.Ports.Count > 0);
        if (controller == null)
        {
            ShowAction("ERROR: no AC Infinity controller with ports configured");
            return;
        }

        phase.AcFans.Add(new AcFanState { Controller = controller.Name, Port = controller.Ports[0].Port, Level = 0 });
    }

    private void AddPhase()
    {
        if (CycleService.CycleConfig == null) return;
        var phases = EditorPhases;
        phases.Add(new CyclePhase
        {
            Name = $"Phase {phases.Count + 1}",
            Start = new TimeOnly(12, 0),
            Actors = new List<ActorState>()
        });
    }

    private static MarkupString StageIcon(string stage) => stage switch
    {
        "Seedling" => IconSprout,
        "Bloom" => IconFlower,
        _ => IconLeaf
    };

    private static MarkupString PhaseIcon(string phaseName)
    {
        var name = phaseName.ToLowerInvariant();
        if (name.Contains("high") || name.Contains("day")) return IconSun;
        if (name.Contains("low") || name.Contains("night")) return IconMoon;
        return IconTimer;
    }

